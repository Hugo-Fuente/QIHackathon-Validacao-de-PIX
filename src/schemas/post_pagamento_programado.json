{
  "title": "PostPagamentoProgramado",
  "type": "object",
  "properties": {
    "conta_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "meio": {
      "type": "string",
      "enum": [
        "PIX",
        "TED",
        "BOLETO"
      ]
    },
    "valor_centavos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "contraparte": {
      "type": "object"
    },
    "referencia_externa": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "data_prevista": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "responsabilidade_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "categoria": {
      "type": "string",
      "maxLength": 40
    },
    "descricao": {
      "type": "string",
      "maxLength": 140
    }
  },
  "required": [
    "conta_id",
    "meio",
    "valor_centavos",
    "contraparte",
    "data_prevista"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "meio": {
            "const": "PIX"
          }
        },
        "required": [
          "meio"
        ]
      },
      "then": {
        "required": [
          "contraparte"
        ],
        "properties": {
          "contraparte": {
            "$ref": "contraparte_pix.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "meio": {
            "const": "TED"
          }
        },
        "required": [
          "meio"
        ]
      },
      "then": {
        "required": [
          "contraparte"
        ],
        "properties": {
          "contraparte": {
            "$ref": "contraparte_ted.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "meio": {
            "const": "BOLETO"
          }
        },
        "required": [
          "meio"
        ]
      },
      "then": {
        "required": [
          "contraparte"
        ],
        "properties": {
          "contraparte": {
            "$ref": "contraparte_boleto.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "meio": {
            "const": "BOLETO"
          }
        },
        "required": [
          "meio"
        ]
      },
      "then": {
        "required": [
          "referencia_externa"
        ]
      }
    }
  ],
  "additionalProperties": false
}